{
  "name": "quran-flash-desktop",
  "productName": "Quran Flash",
  "version": "1.0.0",
  "description": "An Electron desktop application for the Quran flipbook.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev:full": "electron .",
    "build": "electron-builder -w",
    "build:dir": "electron-builder --dir"
  },
  "keywords": [
    "quran",
    "electron",
    "flipbook"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.quranflash.app",
    "productName": "Quran Flash",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "data/Quran_Page_001.fbk"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
